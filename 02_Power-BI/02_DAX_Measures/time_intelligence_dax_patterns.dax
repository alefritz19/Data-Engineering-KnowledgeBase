// ==============================================================================
// Zweck:    DAX Best Practice Patterns: Time Intelligence, YoY Growth, Kumulation
// Kontext:  Power BI / DAX Measures
// Autor:    Alexander Fritzler
// ==============================================================================

// 1. Basis-Umsatzmaß
Total Sales = 
SUM ( fct_Sales[SalesAmount] )

// 2. Umsatz seit Jahresbeginn (Year-To-Date)
Sales YTD = 
TOTALYTD ( 
    [Total Sales], 
    dim_Date[Date] 
)

// 3. Umsatz im Vergleichszeitraum des Vorjahres (Prior Year)
Sales Prior Year = 
CALCULATE ( 
    [Total Sales], 
    SAMEPERIODLASTYEAR ( dim_Date[Date] ) 
)

// 4. Vorjahreswachstum in Währung (YoY Growth €)
Sales YoY Growth € = 
[Total Sales] - [Sales Prior Year]

// 5. Prozentuales Vorjahreswachstum (YoY Growth %)
Sales YoY Growth % = 
DIVIDE ( 
    [Sales YoY Growth €], 
    [Sales Prior Year], 
    BLANK() 
)

// 6. Gleitender 3-Monats-Durchschnitt (Moving Average)
Sales 3M Moving Avg = 
CALCULATE (
    AVERAGEX ( 
        DATESINPERIOD ( dim_Date[Date], MAX ( dim_Date[Date] ), -3, MONTH ),
        [Total Sales]
    )
)
